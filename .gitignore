# DropoutGuard - AI-Powered Early-Warning and Student Support System

# Python & Environment
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
*.db

# Data & Heavy Processed Datasets (keep directories via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/**/*.csv
!data/processed/.gitkeep
!data/processed/feature_metadata.json
data/synthetic/*.csv
!data/synthetic/.gitkeep
*.parquet

# Model Binary Artifacts (keep lightweight configs & .gitkeep)
ml/artifacts/**/*.joblib
ml/artifacts/*.pkl
!ml/artifacts/.gitkeep
!ml/artifacts/interventions.json
!ml/artifacts/feature_names.json
!ml/artifacts/model_metrics.json

# Frontend & Build
frontend/node_modules/
frontend/dist/
frontend/.env.local
.DS_Store

# IDE & Secrets
.vscode/
.idea/
.env
backend/.env
*.env.local

# Backend (Alembic migration versions ARE tracked — they are schema source of truth)
.mypy_cache/
.ruff_cache/

# Legacy local-only documentation copy (its tracked counterpart was removed); never commit
/DROPOUTGUARD_PROJECT_DOCUMENTATION.txt
