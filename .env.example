# DropoutGuard Environment Configuration

# Database Configuration
DATABASE_URL=sqlite:///./data/dropout_guard.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://dropoutguard_user:dropoutguard_pass@db:5432/dropoutguard_db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Risk Score Thresholds (Configurable)
RISK_THRESHOLD_LOW=0.33
RISK_THRESHOLD_HIGH=0.66

# ML Model Paths
MODEL_ARTIFACT_PATH=ml/artifacts/calibrated_model.joblib
SHAP_EXPLAINER_PATH=ml/artifacts/shap_explainer.joblib
INTERVENTION_RULES_PATH=ml/artifacts/interventions.json
