# DropoutGuard Environment Configuration
# Copy to .env and fill in real values. .env is gitignored — never commit credentials.

# =============================================================================
# Database (Neon hosted PostgreSQL)
# =============================================================================
# Neon issues URLs as `postgresql://...`; the backend rewrites them to the psycopg3
# driver automatically. sslmode=require is mandatory for Neon.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Optional: a separate Neon BRANCH used by the test suite. The tests create and drop
# tables, so never point this at the branch holding real data. When unset, all
# live-database tests skip instead of failing.
# TEST_DATABASE_URL=postgresql://<user>:<password>@<test-endpoint>.neon.tech/<database>?sslmode=require

# Connection pooling. Neon closes idle connections, so recycle before it does.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=280
DB_ECHO=False

# =============================================================================
# API
# =============================================================================
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated explicit origins. Add the deployed frontend origin here.
# NEVER use "*" together with credentials — the app force-disables credentials if you do.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# ML core (read by ml/config.py — shared with the backend, not duplicated)
# =============================================================================
RISK_THRESHOLD_LOW=0.33
RISK_THRESHOLD_HIGH=0.66
RANDOM_SEED=42
